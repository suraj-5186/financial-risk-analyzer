# FinRisk AI — Backend Environment Variables
# Copy this file to .env for local development and fill in real values.
# In production (Render), set these via the Render dashboard or render.yaml.

# ── Required ──────────────────────────────────────────────────────────────────

# Database connection string.
# Local SQLite (default when unset):   sqlite:///./financial_risk.db
# Production PostgreSQL (Render):       postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./financial_risk.db

# JWT signing secret. Use a long, randomly-generated string in production.
# Never use the default value in production.
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# ── Optional ──────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins for CORS.
# Leave empty to allow all origins (local dev default).
# Example: https://your-app.vercel.app
ALLOWED_ORIGINS=

# Gemini AI API key for the AI Chat feature.
# If unset, the chatbot falls back to a rule-based response engine.
GEMINI_API_KEY=

# ── Email / Password Reset Configuration ──────────────────────────────────────
# SMTP Host (e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.mailtrap.io).
# If unset, the backend operates in safe local dev mode (logs reset requests safely).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@finrisk.ai
SMTP_USE_TLS=true

# Public URL of the frontend (used to generate password reset links).
# Local dev default: http://localhost:5173
# Production default: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Password reset token expiration window in minutes (default: 30)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── Avatar / Object Storage Configuration ─────────────────────────────────────
# Storage backend: "local" (default for local development) or "s3" (Cloudflare R2, AWS S3, MinIO)
AVATAR_STORAGE_BACKEND=local

# S3-compatible Object Storage settings (Required when AVATAR_STORAGE_BACKEND=s3)
# Example Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Public URL used to serve images directly (e.g. Cloudflare custom domain or public R2 bucket URL)
# Example: https://pub-xxxxxxxxxxxx.r2.dev or https://cdn.yourdomain.com
# If unset, defaults to S3_ENDPOINT_URL/S3_BUCKET_NAME
S3_PUBLIC_BASE_URL=

# Maximum avatar upload size in bytes (default: 5242880 = 5 MB)
AVATAR_MAX_SIZE_BYTES=5242880

# ── Bank Synchronization / Open Banking (Task 19) ──────────────────────────────
# Bank sync provider: "mock" (default for local development) or real aggregator ("plaid")
BANK_SYNC_PROVIDER=mock

# Enable/disable bank sync features (default: true)
BANK_SYNC_ENABLED=true

# 32-byte URL-safe base64 key for encrypting bank provider access tokens at rest.
# If unset, FinRisk AI safely derives a key from SECRET_KEY using PBKDF2/SHA-256.
BANK_TOKEN_ENCRYPTION_KEY=

# Optional: Real Open Banking Provider Credentials (e.g. Plaid Sandbox/Production)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
