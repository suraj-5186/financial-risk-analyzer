# FinRisk AI — Frontend Environment Variables
# Copy this file to .env.local for local development.
# In production (Vercel), set these via the Vercel dashboard under Project > Settings > Environment Variables.

# Base URL of the deployed backend API.
# Local dev: leave empty (Vite proxy handles /api/* → localhost:8000)
# Production: set to your Render backend URL, e.g. https://finrisk-ai-backend.onrender.com
VITE_API_BASE_URL=
