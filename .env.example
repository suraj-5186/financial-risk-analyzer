# FinRisk AI — Deployment Environment Variables Template
# Copy or set these environment variables in their respective deployment platforms.
# DO NOT commit real secrets or production credentials into version control.

# ==============================================================================
# 1. FastAPI Backend (Configure in Render Dashboard or render.yaml)
# ==============================================================================

# Database connection string for production PostgreSQL.
# In Render Blueprints, this is automatically linked from the PostgreSQL database service.
# If configuring manually: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql://user:password@hostname:5432/finrisk_ai

# Secret key used for JWT authentication and token hashing.
# In Render Blueprints, this is auto-generated (`generateValue: true`).
# If configuring manually: generate a random string of at least 32 characters.
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# Comma-separated list of allowed frontend origins for CORS.
# Set this to your deployed Vercel frontend URL (do not include trailing slash).
# Example: https://your-finrisk-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Google Gemini API key for AI assistant features (optional).
# If left unset, the backend automatically uses a rule-based advisor fallback.
GEMINI_API_KEY=

# Python version for Render runtime (matches render.yaml)
PYTHON_VERSION=3.11

# Email / Password Reset Configuration
# SMTP server details (e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.mailtrap.io).
# If unset, backend operates in safe dev mode without sending real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@finrisk.ai
SMTP_USE_TLS=true

# Public URL of the frontend (used by backend to construct reset links in emails)
FRONTEND_URL=https://your-frontend.vercel.app

# Password reset token expiration window in minutes (default: 30)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Avatar / Cloud Object Storage Configuration
# Storage backend: "local" (default for local development) or "s3" (Cloudflare R2, AWS S3, MinIO)
AVATAR_STORAGE_BACKEND=local

# S3-compatible Object Storage settings (Required when AVATAR_STORAGE_BACKEND=s3)
# Example Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Public URL used to serve images directly (e.g. Cloudflare custom domain or public R2 bucket URL)
# Example: https://pub-xxxxxxxxxxxx.r2.dev or https://cdn.yourdomain.com
S3_PUBLIC_BASE_URL=

# Maximum avatar upload size in bytes (default: 5242880 = 5 MB)
AVATAR_MAX_SIZE_BYTES=5242880


# ==============================================================================
# 2. React / Vite Frontend (Configure in Vercel Project Settings)
# ==============================================================================

# Public URL of the deployed Render FastAPI backend.
# Example: https://finrisk-ai-backend.onrender.com
# For local dev: leave empty to use the Vite dev server proxy.
VITE_API_BASE_URL=https://finrisk-ai-backend.onrender.com
